# Turso Database Configuration (libSQL)
# Obtain from https://turso.tech/
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Administrator Authentication
# Generate with: npx tsx scripts/generate-admin-hash.ts <your_strong_password>
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# Secure Session Secret (minimum 32 random characters)
SESSION_SECRET=your_random_64_character_session_secret_here

# Public Application URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# University Email Domains (optional, comma-separated, e.g. "ddn.upes.ac.in,upes.ac.in")
UPES_EMAIL_DOMAINS=ddn.upes.ac.in,upes.ac.in

